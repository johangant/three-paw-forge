---
layout: layouts/base.njk
---
<section class="mx-auto max-w-7xl px-6 pt-10 pb-16 md:px-12 md:pt-16 md:pb-24" aria-labelledby="patch-title">
<a href="/about/" class="inline-block py-2 text-sm">← About the maker</a>
<div class="mt-8 grid items-start gap-10 md:grid-cols-2 md:gap-16">
<div>
<p class="mb-4 text-xs font-bold uppercase tracking-widest text-copper">{{ subtitle }}</p>
<h1 id="patch-title" class="font-serif text-5xl md:text-6xl">{{ heading }}</h1>
<div class="mt-6 max-w-xl text-lg leading-relaxed">{{ content | safe }}</div>
<a href="#patch-gallery" class="mt-6 inline-block py-2 font-bold">Photographs of Patch ↓</a>
</div>
<figure class="mx-auto w-full max-w-sm">
<picture class="block w-full">
<source type="image/webp" srcset="{{ portrait.srcset | replace(r/\.jpg/g, '.webp') }}" sizes="(min-width: 432px) 384px, calc(100vw - 48px)">
<img src="{{ portrait.src }}" srcset="{{ portrait.srcset }}" sizes="(min-width: 432px) 384px, calc(100vw - 48px)" width="{{ portrait.width }}" height="{{ portrait.height }}" alt="{{ portrait.alt }}" fetchpriority="high" decoding="async" class="block h-auto w-full">
</picture>
<figcaption class="mt-3 text-sm leading-relaxed">{{ portrait.caption }}</figcaption>
</figure>
</div>
</section>
<section id="patch-gallery" class="border-t border-coal/20 py-16 md:py-24" aria-labelledby="gallery-title">
<div class="mx-auto max-w-7xl px-6 md:px-12">
<p class="mb-3 text-xs font-bold uppercase tracking-widest text-copper">The gallery</p>
<h2 id="gallery-title" class="font-serif text-4xl md:text-5xl">Life at Patch’s pace.</h2>
<div class="mt-10 grid items-start gap-10 sm:grid-cols-2 lg:grid-cols-3">
{% for photo in gallery %}
{% include "gallery-photo.njk" %}
{% endfor %}
</div>
<p class="mt-10"><a href="/about/" class="inline-block py-2 font-bold">Back to the story of Three Paw Forge →</a></p>
</div>
</section>
{% include "gallery-lightbox.njk" %}
