{% if currentWorkPhotos.length %}
<section id="current-work" class="border-t border-coal/20 py-16 md:py-24" aria-labelledby="current-work-title">
<div class="mx-auto max-w-7xl px-6 md:px-12">
<p class="mb-3 text-xs font-bold uppercase tracking-widest text-copper">On the workbench</p>
<h2 id="current-work-title" class="font-serif text-4xl md:text-5xl">What I’m currently working on</h2>
<p class="mt-5 max-w-2xl text-lg leading-relaxed">{{ currentWork.intro }}</p>
<div class="mt-10 grid items-start gap-10 sm:grid-cols-2 lg:grid-cols-3">
{% for photo in currentWorkPhotos %}
{% include "gallery-photo.njk" %}
{% endfor %}
</div>
</div>
</section>
{% set galleryTitle = 'What I’m currently working on' %}
{% include "gallery-lightbox.njk" %}
{% endif %}
