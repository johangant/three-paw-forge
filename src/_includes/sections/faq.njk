<section id="faq" class="mx-auto max-w-7xl px-6 py-20 md:px-12 md:py-28" aria-labelledby="faq-title">
<p class="mb-3 text-xs font-bold uppercase tracking-widest text-copper">A few things you might be wondering</p>
<h1 id="faq-title" class="font-serif text-4xl md:text-6xl">Frequently asked questions</h1>
<div class="mt-8 max-w-3xl border-t border-coal/20">
{% for item in faq %}
<details class="border-b border-coal/20 py-5">
<summary class="cursor-pointer py-2 text-lg font-bold">{{ item.question }}</summary>
<div class="mt-3 leading-relaxed">{{ item.answer | faqMarkdown | safe }}{% if item.url %}<p class="mt-3"><a href="{{ item.url }}">{{ item.linkLabel }} →</a></p>{% endif %}</div>
</details>
{% endfor %}
</div>
</section>
