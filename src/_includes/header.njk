<header class="mx-auto flex w-full max-w-7xl flex-col items-start justify-between gap-5 px-6 py-6 sm:flex-row sm:items-center sm:gap-8 md:px-12 md:py-8">
<a href="/" aria-label="Three Paw Forge home" class="inline-block max-w-full shrink-0"><img src="/three-paw-forge-logo.svg" alt="Three Paw Forge" width="605.15" height="107.35" class="block h-auto w-72 max-w-full lg:w-80"></a>
<nav aria-label="Main navigation" class="flex w-full items-center justify-between gap-6 text-sm sm:w-auto sm:justify-end md:gap-8">{% for item in site.navigation %}<a class="py-2" href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}</nav>
</header>
